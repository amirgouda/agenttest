# ── Ordoor (the system under test) ─────────────────────────────────────────────
# Base URL of the running Ordoor app.
ORDOOR_BASE_URL=http://localhost:3000
# Must equal WHATSAPP_SIMULATOR_TOKEN in Ordoor's .env.local (the simulator API is off without it).
ORDOOR_SIMULATOR_TOKEN=change-me-long-random-string

# ── The testing agent's own model ──────────────────────────────────────────────
# gemini | anthropic  (default: gemini when GEMINI_API_KEY is set, else anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── This app ───────────────────────────────────────────────────────────────────
AGENT_TEST_PORT=4100
# How many scenario runs may talk to Ordoor at once. Keep 1 unless you know the store queue:
# every rehearsal order of a store shares that store's number, so parallel orders queue behind each other.
RUN_CONCURRENCY=1

# ── Storage ── this app's own PostgreSQL database (never Ordoor's). Tables are created on start.
#   CREATE ROLE agent_test LOGIN PASSWORD '…';
#   CREATE DATABASE ordoor_agent_test OWNER agent_test;
DATABASE_URL=postgresql://agent_test:change-me@localhost:5432/ordoor_agent_test
